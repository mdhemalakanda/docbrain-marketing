# Stripe — same keys as docbrain/dashboard (required for free-trial signup)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# DocBrain Silver recurring price ID from Stripe Dashboard → Products
STRIPE_PRICE_ID_SILVER=price_xxxxxxxx
# Optional (defaults: 10 days trial)
# STRIPE_TRIAL_DAYS=10

# Link to DocBrain dashboard signup after trial starts
DOCBRAIN_APP_URL=http://localhost:3000

# Optional: override hero demo video URL (default: /demo/docbrain-sales-agent-demo.mp4 in public/)
# NEXT_PUBLIC_DEMO_VIDEO_URL=https://your-dashboard.example.com/demo/docbrain-sales-agent-demo.mp4

# Optional: POST new leads to a webhook (Zapier, Make, Slack, etc.)
# LEADS_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/...

# Optional: notify you when someone starts free access
# RESEND_API_KEY=re_...
# LEADS_NOTIFY_EMAIL=you@example.com
# LEADS_FROM_EMAIL=DocBrain <hello@yourdomain.com>
